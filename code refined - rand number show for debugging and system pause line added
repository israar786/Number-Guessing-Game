#include "iostream"
#include "cstdlib"
#include "ctime"
using namespace std;

int main() {

 srand(time(0));
 int i = rand() %100 + 1; //set counter limit, currently 1-100
 int x;
 int attempts = 0;



 cout << "I'm thinking of a number can you guess it!\n";
 cout << "Type your guess\n";

 cout <<"number =" << i << " \n"; //debug line - shows random number

 cin >> x;

 attempts++;

 while (x != i) {



   if (x > i) {

   cout << "Too High\n";

 }
   else if (x < i) {

   cout << "Too Low\n";

 }

   cout << "Try again\n";
   cin >> x;

   attempts++;
 }

 cout << "correct\n";
 cout << "number of attempts = " <<attempts<< "\n";

 system("pause");

 return 0;
}

/*
time(0) → changing number (based on clock)
       ↓
srand() → sets randomness starting point
       ↓
rand() → generates numbers
       ↓
% 100 + 1 → keeps it in range 1–100
*/
