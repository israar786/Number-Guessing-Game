#include "iostream"
#include "cstdlib"
#include "ctime"
using namespace std;

void game() {

 int i = rand() %100 + 1; //set counter limit, currently 1-100
 int x;
 int attempts = 0;
 int a;
 int y;

 cout << "I'm thinking of a number can you guess it!\n";
 cout << "Type your guess\n";

 cout <<"number =" << i << " \n";

 cin >> x;

 attempts++;

 while (x != i) {


   if (x > i) {

   cout << "Too High\n";

 }
   else if (x < i) {

   cout << "Too Low\n";

 }

   cout << "Try again\n";
   cin >> x;

   attempts++;
 }

 cout << "correct\n";
 cout << "number of attempts = " <<attempts<< "\n";


}

int main() {

 srand(time(0));

 char a = 'y';

 while (a == 'y') {     //== compares values, 'y' is a character literal

     game();

do {

     cout << "play again; (y/n)\n";

     cin >> a;

 if (a != 'y' && a != 'n') {

    cout << "invalid input please type y for yes and n for no\n";

 }
 } while (a != 'y' && a != 'n');


 }
 cout << "Thanks for playing!\n";
 system("pause");

 return 0;
}
